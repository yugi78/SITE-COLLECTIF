---
import Layout from "../layouts/Layout.astro";
import PageView from "../puck/PageView";
import { stripHidden } from "../lib/visibility";
import { faqLd, resolveSeo } from "../lib/seo";
import raw from "../data/pages/accueil.json";

const data = stripHidden(raw);
const seo = resolveSeo(data);
---
<Layout {...seo} jsonLd={[faqLd(data)]}>
  <PageView data={data} client:load />
</Layout>
