---
import "../styles/global.css";
import site from "../data/site.json";
import { themeStyleString } from "../lib/theme";
import { absolute, clean, globals, orgLd } from "../lib/seo";

interface Props {
  title?: string; description?: string; image?: string; imageAlt?: string;
  noindex?: boolean;          // page publique exclue des moteurs (meta robots + absente du sitemap)
  editor?: boolean;           // éditeur Puck : aucune balise SEO, noindex, pas d'animations
  jsonLd?: (object | null)[]; // données structurées propres à la page (fil d'Ariane, FAQ…)
}
const { title, description, image, imageAlt, noindex = false, editor = false, jsonLd = [] } = Astro.props;
const g = globals();
const t = clean(title) || g.name;
const desc = clean(description) || g.description;
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const img = absolute(clean(image) || g.image, base);
const imgAlt = clean(image) ? clean(imageAlt) : g.imageAlt;
const locale = g.lang.includes("-") ? g.lang.replace("-", "_") : `${g.lang}_${g.lang.toUpperCase()}`;
const ld = editor ? [] : [orgLd(base), ...jsonLd].filter(Boolean);
const json = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
// Animations (chargement, transitions, scroll) uniquement sur le site public, jamais dans l'éditeur Puck.
const motion = !editor;
const brand = (site.root.props.brand || "").replace(/\[\[|\]\]/g, "");
---
<!doctype html>
<html lang={g.lang} style={themeStyleString(site.root.props)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={g.themeColor} />
    {(editor || noindex) && <meta name="robots" content="noindex" />}
    {!editor && (
      <>
        {desc && <meta name="description" content={desc} />}
        {!noindex && <link rel="canonical" href={canonical} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={g.name} />
        <meta property="og:locale" content={locale} />
        <meta property="og:title" content={t} />
        {desc && <meta property="og:description" content={desc} />}
        <meta property="og:url" content={canonical} />
        {img && <meta property="og:image" content={img} />}
        {img && imgAlt && <meta property="og:image:alt" content={imgAlt} />}
        <meta name="twitter:card" content={img ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={t} />
        {desc && <meta name="twitter:description" content={desc} />}
        {img && <meta name="twitter:image" content={img} />}
        {img && imgAlt && <meta name="twitter:image:alt" content={imgAlt} />}
        {ld.map((o) => <script type="application/ld+json" set:html={json(o)} />)}
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    {motion && (
      <script is:inline>
        // Posé avant le premier rendu : écran de chargement à la 1re visite, voile de transition ensuite.
        (function () {
          var d = document.documentElement, s = null;
          try { s = window.sessionStorage; } catch (e) {}
          var forced = /[?&]intro\b/.test(location.search);
          var seen = s && s.getItem("intro-done");
          if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
            if (forced || !seen) d.classList.add("has-loader");
            else if (s && s.getItem("pt")) d.classList.add("pt-in");
          }
        })();
      </script>
    )}
  </head>
  <body>
    {motion && (
      <>
        <div id="loader" aria-hidden="true">
          <div class="ld-name"><span class="ld-base">{brand}</span><span class="ld-fill">{brand}</span></div>
          <div class="ld-pct">0%</div>
        </div>
        <div id="pt" aria-hidden="true"></div>
      </>
    )}
    <slot />
    {motion && <script>import "../scripts/motion";</script>}
  </body>
</html>
